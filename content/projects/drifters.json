        "parts": [
          {
            "kind": "text",
            "heading": "Amos Rex",
            "body": "One of the most innovative and modern contemporary art galleries of Northern Europe, Amos Rex rethinks the urban park as part of the museum experience. Its structure is built with large concrete domes and features unique exhibition halls as well as public spaces.",
            "dark": true
          },
          {
            "kind": "film",
            "film": {
              "provider": "youtube",
              "id": "TDTQ_it3zaQ",
              "poster": "https://cdn.prod.website-files.com/6465c08bc2eb8d26649eade8/661e05d79d8c67c185516d7e_Drifters.AmosCover.jpg",
