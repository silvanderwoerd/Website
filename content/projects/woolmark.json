      "content": {
        "image": {
          "src": "https://cdn.prod.website-files.com/6465c08bc2eb8d26649eade8/65c9b202f78ae07595cfc900_OilFilledPool.BG.jpg",
          "alt": ""
        },
        "parts": [
          {
            "kind": "text",
            "heading": "Oil Filled Pool",
            "body": "The special effects team of Max Poolman at MXFX built a custom 6x6 meter pool that was filled with 36,000 liters of fake oil, created from a mixture of water, food thickener and edible children's paint. Lighting the pool was a significant challenge as the pool essentially acted as a mirror, reflecting everything visible in the studio. A white dome was created over the pool that was lit to match the nature plates that were previously shot on location."
          },
          {
            "kind": "film",
